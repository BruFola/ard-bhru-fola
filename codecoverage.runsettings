<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
	<DataCollectionRunSettings>
		<DataCollectors>
			<DataCollector friendlyName ="XPlat Code Coverage">
				<Configuration>

					<Exclude> [*]BPCalculator.Program,[*]BPCalculator.Startup</Exclude> 
					<ExcludeByFile>**/*.cshtml,**/Error.cshtml.cs</ExcludeByFile>

</Configuration>
			 </DataCollector>
			
		</DataCollectors>
	</DataCollectionRunSettings>
</RunSettings>